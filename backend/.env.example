PORT=4000
NODE_ENV=development

# PostgreSQL connection
DATABASE_URL=postgresql://user:password@localhost:5432/clinic_db

# Comma-separated list of allowed origins for CORS (credentialed requests
# require an exact match — no wildcards)
FRONTEND_ORIGIN=http://localhost:3000

# Public base URL of THIS API (used to build absolute /uploads links).
# Leave blank to auto-derive from the request in dev.
PUBLIC_API_URL=

# Admin panel authentication
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_SEED_EMAIL=admin@clinicname.com
ADMIN_SEED_PASSWORD=change-this-password
ADMIN_SEED_NAME=Clinic Admin

# Outgoing email (contact form, booking, reminders, password reset) — leave
# blank to disable email sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFY_EMAIL=info@clinicname.com
BOOKING_NOTIFY_EMAIL=bookings@clinicname.com

# SMS / WhatsApp (Twilio) — optional, leave blank to disable. Needs a paid
# Twilio account; booking still works fine without these set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Payments / deposits (Stripe) — optional, leave blank to disable. Needs a
# Stripe account; if a service has a deposit_cents value set but Stripe
# isn't configured, the booking still succeeds without collecting a deposit.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
